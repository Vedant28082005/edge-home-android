<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: transparent, control-line edge (3:1), radius-md -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33808080">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/focus" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/control_line" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
